# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- JWT (RS256) ---
# Generate the key pair locally:
#   mkdir -p .env
#   openssl genpkey -algorithm RSA -out .env/jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in .env/jwt-private.pem -out .env/jwt-public.pem
JWT_PRIVATE_KEY_PATH=.env/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.env/jwt-public.pem

# --- PostgreSQL ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=

# --- Stripe (test mode) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# --- App ---
# Change in production; used to sign cookies / internal tokens if needed
APP_SECRET=
